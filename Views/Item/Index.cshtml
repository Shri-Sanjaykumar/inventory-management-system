@model IEnumerable<Item>
@{
    ViewData["Title"] = "Items List";
}

<div class="main-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1">Item Master</h3>
            <p class="text-muted small mb-0">Manage materials, units, and inventory balances</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-custom-primary">
                <i class="fa-solid fa-plus me-1"></i> Add Item
            </a>
        </div>
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Item Name or Unit of Measure..." value="@ViewData["SearchTerm"]" />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100">Search</button>
            </div>
        </div>
    </form>

    <!-- Table -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted border rounded bg-light">
            <i class="fa-solid fa-box-open mb-3" style="font-size: 40px;"></i>
            <p>No items found. Click "Add Item" to define a new material.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-custom align-middle">
                <thead>
                    <tr>
                        <th>Item Details</th>
                        <th>UOM (Unit)</th>
                        <th>Opening Stock</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark" style="font-size: 15px;">@item.ItemName</div>
                                <small class="text-muted">ID: @item.ItemID</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.UnitOfMeasure</span>
                            </td>
                            <td>
                                <span class="fw-bold">@item.OpeningBalance</span>
                            </td>
                            <td class="text-muted" style="font-size: 13px; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @(string.IsNullOrWhiteSpace(item.DetailedDescription) ? "No description" : item.DetailedDescription)
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.ItemID" class="btn btn-sm btn-outline-secondary" title="Edit Item">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("Backend Developer"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.ItemID" method="post" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Item">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
