@model IEnumerable<Project>
@{
    ViewData["Title"] = "Project List";
}

<div class="main-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1">Project Master</h3>
            <p class="text-muted small mb-0">Manage construct and delivery project registries</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-custom-primary">
                <i class="fa-solid fa-plus me-1"></i> Add Project
            </a>
        </div>
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Project Name, City or State..." value="@ViewData["SearchTerm"]" />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100">Search</button>
            </div>
        </div>
    </form>

    <!-- Table -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted border rounded bg-light">
            <i class="fa-solid fa-diagram-project mb-3" style="font-size: 40px;"></i>
            <p>No projects found. Click "Add Project" to register a new build site.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-custom align-middle">
                <thead>
                    <tr>
                        <th>Project Details</th>
                        <th>Site Address</th>
                        <th>Created By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-primary" style="font-size: 15px;">@item.ProjectName</div>
                                <small class="text-muted">ID: @item.ProjectID</small>
                            </td>
                            <td>
                                <div>@item.AddressLine1</div>
                                <small class="text-muted">@item.City, @item.State - @item.Pincode</small>
                            </td>
                            <td>
                                <div class="fw-medium">@item.CreatedBy</div>
                                <small class="text-muted" style="font-size: 11px;">@item.CreatedOn.ToLocalTime().ToString("g")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.ProjectID" class="btn btn-sm btn-outline-secondary" title="Edit Project">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("Backend Developer"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.ProjectID" method="post" onsubmit="return confirm('Are you sure you want to delete this project?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Project">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
