@{
    ViewData["Title"] = "Error";
}

<div class="main-card mt-5 text-center py-5">
    <i class="fa-solid fa-triangle-exclamation text-danger mb-3" style="font-size: 48px;"></i>
    <h2 class="fw-bold text-danger">An Error Occurred</h2>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    <p class="text-muted small">Please contact the system administrator or check the application logs.</p>
    <div class="mt-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Go Back
        </a>
        <a asp-controller="StockReceipt" asp-action="Index" class="btn btn-custom-primary">
            <i class="fa-solid fa-house me-1"></i> Return Home
        </a>
    </div>
</div>
