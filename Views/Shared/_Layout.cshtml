<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Manager</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for clean icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc; /* Light slate bg */
            color: #0f172a;
        }
        .navbar-custom {
            background-color: #1e293b; /* Slate 800 */
        }
        .navbar-custom .navbar-brand, .navbar-custom .nav-link {
            color: #cbd5e1;
        }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active {
            color: #ffffff;
        }
        .navbar-custom .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .main-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            padding: 30px;
            margin-top: 30px;
        }
        .table-custom th {
            background-color: #f1f5f9;
            color: #475569;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
        }
        .btn-custom-primary {
            background-color: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
            font-weight: 500;
        }
        .btn-custom-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
        }
        .form-label {
            font-weight: 500;
            font-size: 13px;
            color: #475569;
        }
        .status-badge {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 4px 8px;
            border-radius: 4px;
        }
        .footer {
            border-top: 1px solid #e2e8f0;
            padding: 20px 0;
            font-size: 13px;
            color: #64748b;
            margin-top: 60px;
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="StockReceipt" asp-action="Index">
                <i class="fa-solid fa-boxes-stacked me-2"></i>InventoryPortal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-link-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockReceipt" ? "active" : "")" asp-controller="StockReceipt" asp-action="Index">
                                <i class="fa-solid fa-receipt me-1"></i> Stock Receipts
                            </a>
                        </li>
                        <li class="nav-link-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendor" ? "active" : "")" asp-controller="Vendor" asp-action="Index">
                                <i class="fa-solid fa-truck-field me-1"></i> Vendor Master
                            </a>
                        </li>
                        <li class="nav-link-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Project" ? "active" : "")" asp-controller="Project" asp-action="Index">
                                <i class="fa-solid fa-diagram-project me-1"></i> Project Master
                            </a>
                        </li>
                        <li class="nav-link-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Item" ? "active" : "")" asp-controller="Item" asp-action="Index">
                                <i class="fa-solid fa-box-open me-1"></i> Item Master
                            </a>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="text-light me-3 text-end d-none d-sm-block">
                            <div class="fw-semibold text-white">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</div>
                            <small class="text-muted" style="font-size: 11px;">@User.FindFirst("Designation")?.Value</small>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-light">
                                <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Sign Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light me-2">Sign In</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-custom-primary">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Grid -->
    <div class="container">
        <main role="main" class="pb-3">
            <!-- Global Flash Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Clean Footer -->
    <footer class="footer text-center bg-white mt-auto">
        <div class="container">
            &copy; 2026 - InternInventory System - Clean C# ASP.NET Core MVC Implementation
        </div>
    </footer>

    <!-- Bootstrap 5 and jQuery Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
