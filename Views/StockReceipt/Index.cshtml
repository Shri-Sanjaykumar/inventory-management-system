@model IEnumerable<StockReceipt>
@{
    ViewData["Title"] = "Stock Receipts";
}

<div class="main-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1">Stock Receipts Log</h3>
            <p class="text-muted small mb-0">Record and track inventory materials received at project sites</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-custom-primary">
                <i class="fa-solid fa-plus me-1"></i> New Stock Receipt
            </a>
        </div>
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Vendor, Project, Item Name, or Logged User..." value="@ViewData["SearchTerm"]" />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100">Search</button>
            </div>
        </div>
    </form>

    <!-- Table -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted border rounded bg-light">
            <i class="fa-solid fa-receipt mb-3" style="font-size: 40px;"></i>
            <p>No stock receipts recorded. Click "New Stock Receipt" to enter a receipt record.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-custom align-middle">
                <thead>
                    <tr>
                        <th>Receipt Details</th>
                        <th>Vendor (Supplier)</th>
                        <th>Project Site</th>
                        <th>Material Item</th>
                        <th>Quantity</th>
                        <th>Logged By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">#@item.StockReceiptID</div>
                                <small class="text-muted"><i class="fa-regular fa-calendar me-1"></i>@item.ReceiptDate.ToString("yyyy-MM-dd")</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Vendor?.FullName</div>
                                <small class="text-muted">ID: @item.VendorID</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-secondary">@item.Project?.ProjectName</div>
                                <small class="text-muted">ID: @item.ProjectID</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Item?.ItemName</div>
                                <small class="text-muted">ID: @item.ItemID | Unit: @item.Item?.UnitOfMeasure</small>
                            </td>
                            <td>
                                <span class="badge bg-primary text-white" style="font-size: 13px; font-weight: 600;">@item.Quantity</span>
                            </td>
                            <td>
                                <div class="fw-medium">@item.CreatedBy</div>
                                <small class="text-muted" style="font-size: 11px;">@item.CreatedOn.ToLocalTime().ToString("g")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.StockReceiptID" class="btn btn-sm btn-outline-secondary" title="Edit Receipt">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("Backend Developer"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.StockReceiptID" method="post" onsubmit="return confirm('Are you sure you want to delete this stock receipt?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Receipt">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
